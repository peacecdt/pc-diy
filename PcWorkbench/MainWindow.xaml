<Window x:Class="PcWorkbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="装机工坊 · 个人版" Width="1480" Height="940" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid Margin="26,20,26,14">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#187A64" CornerRadius="10" Width="40" Height="40"><TextBlock Text="PC" Foreground="White" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="装机工坊" FontSize="22" FontWeight="Bold"/><TextBlock Text="PC WORKBENCH / 个人版" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="使用说明" Click="Help_Click" Margin="0,0,10,0"/><Button Content="打开配置" Click="Open_Click" Margin="0,0,10,0"/><Button Content="保存配置" Click="Save_Click" Margin="0,0,10,0"/><Button Content="导出清单" Style="{StaticResource Primary}" Click="Export_Click"/></StackPanel>
  </Grid>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" x:Name="Tabs">
   <TabItem Header="配置工作台">
    <Grid Margin="0,16,0,0">
     <Grid.RowDefinitions><RowDefinition x:Name="HeroRow" Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="下一台电脑，由你定义。" FontSize="25" FontWeight="Bold"/><TextBlock Text="挑选配件 · 核对兼容 · 比较商品 · 保存方案" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="已录入价格合计" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalText" Text="¥ 0" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="PriceCoverage" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="硬件库" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CatalogCount" FontSize="30" FontWeight="Bold"/><TextBlock Text="社区规格 / 国内商品另行核验" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
     </Grid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="12" BorderBrush="#E0E6E3" BorderThickness="1">
       <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="我的配置单" FontSize="17" FontWeight="Bold"/><TextBox x:Name="PlanName" Margin="0,10,0,8" TextChanged="PlanMeta_Changed" ToolTip="配置名称"/><ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed" ToolTip="加载示例方案" DisplayMemberPath="Name"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用途" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="UsageBox" SelectionChanged="Usage_Changed"><ComboBoxItem Content="办公 / 学习"/><ComboBoxItem Content="1080p 游戏"/><ComboBoxItem Content="2K 游戏"/><ComboBoxItem Content="4K 游戏"/><ComboBoxItem Content="创作 / 渲染"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="预算 / 元" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="BudgetBox" TextChanged="Budget_Changed" ToolTip="用于检查已录入合计是否超预算"/></StackPanel></Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="BuildRows"/></ScrollViewer>
        <Button Grid.Row="3" Content="新建空白配置" Click="New_Click" Margin="0,12,0,0"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E0E6E3" BorderThickness="1">
       <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock x:Name="CategoryTitle" Text="挑选处理器" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="ResultCount" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="输入品牌、型号；多个关键词以空格分隔"/><TextBlock Text="搜索品牌、型号（支持中文品牌）" Margin="11,0,8,0" VerticalAlignment="Center" Foreground="#9BA69F" IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="SortBox" Grid.Column="2" SelectionChanged="Search_Changed"><ComboBoxItem Content="品牌 / 型号"/><ComboBoxItem Content="价格从低到高"/><ComboBoxItem Content="最近更新"/></ComboBox></Grid>
        <DataGrid Grid.Row="2" x:Name="PartsGrid" SelectionChanged="Part_Changed" MouseDoubleClick="Part_DoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="型号 / 规格" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Summary}" Foreground="#68767F" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="价格" Binding="{Binding PriceText}" Width="100"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="3" Background="#F3F7F5" CornerRadius="8" Margin="0,12,0,0" Padding="12"><StackPanel><TextBlock x:Name="SelectedName" Text="选择一个型号，查看规格与购买入口" FontWeight="Bold"/><TextBlock x:Name="SelectedDetail" Foreground="{StaticResource Muted}" FontSize="11" MaxHeight="60" Margin="0,6,0,10"/><WrapPanel><Button x:Name="AddButton" Content="加入配置" Style="{StaticResource Primary}" Click="Add_Click" Margin="0,0,6,6"/><Button x:Name="JdPurchaseButton" Content="京东搜同款" Click="Jd_Click" Margin="0,0,6,6"/><Button x:Name="TbPurchaseButton" Content="淘宝搜同款" Click="Tb_Click" Margin="0,0,6,6"/><Button Content="商品 / 报价" Click="Offers_Click" Margin="0,0,6,6"/><Button Content="详细规格" Click="Detail_Click" Margin="0,0,6,6"/></WrapPanel><TextBlock Text="搜索入口不代表在售；报价、具体SKU与库存以商品页为准。" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
       </Grid>
      </Border>
      <Border Grid.Column="4" Background="#EAF2EE" CornerRadius="12" BorderBrush="#D7E5DC" BorderThickness="1">
       <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="搭配诊断" FontSize="17" FontWeight="Bold"/><DockPanel Margin="0,18,0,0"><TextBlock x:Name="GradeText" FontSize="35" FontWeight="Bold" Foreground="#187A64"/><TextBlock x:Name="ScoreText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/></DockPanel><TextBlock x:Name="GradeCaption" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,16,0,16"><StackPanel><TextBlock Text="功耗与电源" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PowerText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="PsuText" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FindingRows"/></ScrollViewer>
        <TextBlock Grid.Row="3" Text="规则诊断供选型参考。BIOS、内存QVL、线材接口及实际尺寸仍需购买前核对。" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="联网与数据">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,24,0,10" MaxWidth="1150" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="550"/><ColumnDefinition Width="24"/><ColumnDefinition Width="500"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border Background="White" CornerRadius="12" Padding="24"><StackPanel><TextBlock Text="让硬件库保持更新" FontSize="22" FontWeight="Bold"/><TextBlock Text="从 BuildCores OpenDB 社区同步硬件型号和规格，加入新配件。此来源不含中国电商价格或国内库存。" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/><CheckBox x:Name="AutoCheck" Content="软件运行期间，自动检查更新" Margin="0,0,0,12"/><DockPanel><TextBlock Text="检查间隔（小时）" VerticalAlignment="Center" Margin="0,0,15,0"/><ComboBox x:Name="IntervalBox" Width="100" HorizontalAlignment="Left"><ComboBoxItem Content="6"/><ComboBoxItem Content="12"/><ComboBoxItem Content="24"/><ComboBoxItem Content="48"/></ComboBox></DockPanel><TextBlock x:Name="SyncInfo" Foreground="{StaticResource Muted}" Margin="0,18,0,14"/><WrapPanel><Button Content="立即同步硬件库" Style="{StaticResource Primary}" Click="Sync_Click" Margin="0,0,10,8"/><Button Content="更新本配置商品" Click="SyncOffers_Click" Margin="0,0,10,8"/><Button Content="取消联网任务" Click="Cancel_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
      <Border Background="White" CornerRadius="12" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="数据管理" FontSize="18" FontWeight="Bold"/><TextBlock Text="无网络时使用内置库与上次缓存。配置会自动保存；也可以另存为 JSON。导出的 HTML 清单可用浏览器打开、打印。" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/><WrapPanel><Button Content="导入硬件 JSON" Click="Import_Click" Margin="0,0,10,8"/><Button Content="打开数据文件夹" Click="DataFolder_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="硬件来源：BuildCores OpenDB，CC BY-NC-SA 4.0。此软件供个人非商业使用。参数可能缺漏或有误，来源与抓取时间可在详细规格中查看。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel>
     <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24"><StackPanel><TextBlock Text="商品自动查询" FontSize="22" FontWeight="Bold"/><TextBlock Text="填写你自己的官方开放平台凭据。是否可调用取决于账号的接口权限；未配置时可直接使用京东、淘宝搜索入口。" Foreground="{StaticResource Muted}" Margin="0,10,0,20"/><TextBlock Text="京东联盟" FontSize="16" FontWeight="Bold"/><TextBlock Text="App Key" Margin="0,10,0,5"/><TextBox x:Name="JdKeyBox"/><TextBlock Text="App Secret" Margin="0,10,0,5"/><PasswordBox x:Name="JdSecretBox"/><TextBlock Text="淘宝联盟" FontSize="16" FontWeight="Bold" Margin="0,24,0,0"/><TextBlock Text="App Key" Margin="0,10,0,5"/><TextBox x:Name="TbKeyBox"/><TextBlock Text="App Secret" Margin="0,10,0,5"/><PasswordBox x:Name="TbSecretBox"/><TextBlock Text="Adzone ID（推广位 ID）" Margin="0,10,0,5"/><TextBox x:Name="TbAdzoneBox"/><Button Content="保存联网设置" Style="{StaticResource Primary}" Click="SettingsSave_Click" Margin="0,22,0,0"/><TextBlock Text="凭据使用 Windows DPAPI 加密，仅保存到本机当前用户目录。不会写入配置导出文件。自动查询结果仍需核对具体型号、套餐和卖家。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><WrapPanel Margin="0,18,0,0"><Button Content="京东官方文档" Click="JdDocs_Click" Margin="0,0,10,0"/><Button Content="淘宝官方文档" Click="TbDocs_Click"/></WrapPanel></StackPanel></Border>
    </Grid></ScrollViewer>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="#187A64" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Button Grid.Column="2" Content="查看联网日志" Click="Log_Click" Padding="10,5" Margin="10,0,0,0"/></Grid>
 </Grid>
</Window>
